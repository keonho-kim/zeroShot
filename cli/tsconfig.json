{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@cli/*": ["./src/*"]
    },
    "rootDir": "src"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
