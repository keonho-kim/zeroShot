{
  "name": "@keonhokim/zeroshot",
  "version": "0.0.0-dev.8",
  "description": "ZeroShot production CLI wrapper",
  "type": "module",
  "bin": {
    "zeroshot": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "app"
  ],
  "scripts": {
    "dev": "cd ../src/cli && go run .",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && tsc-alias -p tsconfig.json && sh ../src/cli/scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@openai/codex-sdk": "^0.130.0",
    "axios": "^1.16.1",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "nanoid": "^5.1.11",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  }
}
