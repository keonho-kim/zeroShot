{
  "name": "zeroshot",
  "private": true,
  "version": "0.0.0-dev.6",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "cli",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "bun run --cwd backend build && bun run --cwd cli build && bun run --cwd frontend build",
    "check": "bun run --cwd backend typecheck && bun run --cwd cli typecheck && bun run --cwd frontend typecheck",
    "dev": "bun run dev.ts",
    "serve": "bun run serve.ts",
    "dev:server": "bun run --cwd backend dev",
    "dev:web": "bun run --cwd frontend dev",
    "dev:cli": "bun run --cwd cli dev",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "bun-types": "^1.2.20",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.2"
  }
}
